@page "/docente-departamento"
@rendermode InteractiveServer
@using FrontGestion.Servicios
@inject ServicioDocenteDepartamento Servicio
@inject ServicioDocente ServicioDocente
@inject ServicioPrograma ServicioPrograma
@inject IJSRuntime JS

<PageTitle>Docente - Departamento</PageTitle>

<h1>Docente - Departamento</h1>
<p class="nota">Selecciona un docente y vincúlalo con su programa o departamento académico.</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (errores.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in errores)
        {
            <div>@error</div>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4>
            @(editando
                ? "Editar relación"
                : "Nueva relación")
        </h4>

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Docente</label>

                <select class="form-select"
                        @bind="formulario.Docente"
                        disabled="@editando">

                    <option value="0">
                        Seleccione un docente
                    </option>

                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Cedula -
                            @docente.Nombres
                            @docente.Apellidos
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Departamento / Programa
                </label>

                <select class="form-select"
                        @bind="formulario.Departamento"
                        disabled="@editando">

                    <option value="0">
                        Seleccione un programa
                    </option>

                    @foreach (var programa in programas)
                    {
                        <option value="@programa.Id">
                            @programa.Id - @programa.Nombre
                        </option>
                    }

                </select>
            </div>

            @if (DocenteSeleccionado is not null)
            {
                var docente = DocenteSeleccionado;
                <div class="col-12">
                    <section class="docente-seleccionado" aria-label="Docente seleccionado">
                        <object class="docente-foto"
                                data="@RutaFoto(docente.Cedula)"
                                type="image/jpeg"
                                aria-label="Foto de @docente.Nombres @docente.Apellidos">
                            <div class="docente-avatar-fallback">@Iniciales(docente)</div>
                        </object>

                        <div class="docente-info">
                            <span class="docente-kicker">Docente seleccionado</span>
                            <strong>@docente.Nombres @docente.Apellidos</strong>
                            <div class="docente-detalles">
                                <span>@docente.Cargo</span>
                                <span>@docente.Correo</span>
                            </div>
                        </div>

                        <span class="docente-check">Seleccionado</span>
                    </section>
                </div>
            }

            <div class="col-md-6">
                <label class="form-label">Dedicación</label>

                <input class="form-control"
                       maxlength="15"
                       @bind="formulario.Dedicacion" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Modalidad</label>

                <input class="form-control"
                       maxlength="45"
                       @bind="formulario.Modalidad" />
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Fecha de ingreso
                </label>

                <input type="date"
                       class="form-control"
                       @bind="formulario.FechaIngreso" />
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Fecha de salida
                </label>

                <input type="date"
                       class="form-control"
                       @bind="formulario.FechaSalida" />
            </div>

        </div>

        <div class="mt-3">

            <button class="btn btn-primary me-2"
                    @onclick="Guardar">

                @(editando ? "Guardar cambios" : "Crear")
            </button>

            @if (editando)
            {
                <button class="btn btn-secondary"
                        @onclick="CancelarEdicion">
                    Cancelar
                </button>
            }

        </div>
    </div>
</div>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (relaciones.Count == 0)
{
    <div class="alert alert-info">
        No hay relaciones docente-departamento registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Docente</th>
                    <th>Departamento / Programa</th>
                    <th>Dedicación</th>
                    <th>Modalidad</th>
                    <th>Ingreso</th>
                    <th>Salida</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in relaciones)
                {
                    <tr>

                        <td>
                            @NombreDocente(item.Docente)
                        </td>

                        <td>
                            @NombrePrograma(item.Departamento)
                        </td>

                        <td>@item.Dedicacion</td>
                        <td>@item.Modalidad</td>

                        <td>
                            @item.FechaIngreso?.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @(item.FechaSalida.HasValue
                                ? item.FechaSalida.Value
                                    .ToString("yyyy-MM-dd")
                                : "-")
                        </td>

                        <td>

                            <button class="btn btn-sm btn-warning me-2"
                                    @onclick="() => Editar(item)">
                                Editar
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => Eliminar(item)">
                                Eliminar
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<style>
    .docente-seleccionado {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        margin-top: 2px;
        padding: 13px 15px;
        border: 1px solid #D9E5EF;
        border-radius: 14px;
        background: linear-gradient(135deg, #F8FBFE, #EEF7FA);
    }

    .docente-foto,
    .docente-avatar-fallback {
        width: 58px;
        height: 58px;
        border-radius: 50%;
    }

    .docente-foto {
        display: block;
        overflow: hidden;
        border: 2px solid #fff;
        box-shadow: 0 5px 14px rgba(16,45,105,.12);
        background: #E7F0F7;
        object-fit: cover;
    }

    .docente-avatar-fallback {
        display: grid;
        place-items: center;
        background: linear-gradient(145deg, #102D69, #0B6FA4);
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: .03em;
    }

    .docente-info { min-width: 0; }
    .docente-kicker {
        display: block;
        margin-bottom: 2px;
        color: #0B6FA4;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .07em;
    }
    .docente-info > strong {
        display: block;
        color: #102D69;
        font-size: 1rem;
    }
    .docente-detalles {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        margin-top: 3px;
        color: #667085;
        font-size: .78rem;
    }
    .docente-check {
        padding: 5px 9px;
        border-radius: 999px;
        background: #E5F6EF;
        color: #147A4B;
        font-size: .68rem;
        font-weight: 800;
    }

    @@media (max-width: 640px) {
        .docente-seleccionado { grid-template-columns: auto 1fr; }
        .docente-check { grid-column: 2; justify-self: start; }
    }
</style>

@code {

    private List<DocenteDepartamento> relaciones = new();
    private List<Docente> docentes = new();
    private List<Programa> programas = new();

    private DocenteDepartamento formulario = Nuevo();

    private bool cargando = true;
    private bool editando = false;

    private int docenteOriginal;
    private int departamentoOriginal;

    private string mensaje = string.Empty;
    private List<string> errores = new();

    private Docente? DocenteSeleccionado =>
        docentes.FirstOrDefault(x => x.Cedula == formulario.Docente);

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        errores.Clear();

        var rRelaciones = await Servicio.Listar();
        var rDocentes = await ServicioDocente.Listar();
        var rProgramas = await ServicioPrograma.Listar();

        if (rRelaciones.Ok)
            relaciones = rRelaciones.Datos ?? new();
        else
            errores.AddRange(rRelaciones.Errores);

        if (rDocentes.Ok)
            docentes = rDocentes.Datos ?? new();
        else
            errores.AddRange(rDocentes.Errores);

        if (rProgramas.Ok)
            programas = rProgramas.Datos ?? new();
        else
            errores.AddRange(rProgramas.Errores);

        cargando = false;
    }

    private async Task Guardar()
    {
        mensaje = string.Empty;
        errores.Clear();

        if (formulario.Docente <= 0)
        {
            errores.Add("Debe seleccionar un docente.");
            return;
        }

        if (formulario.Departamento <= 0)
        {
            errores.Add(
                "Debe seleccionar un departamento/programa.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formulario.Dedicacion))
        {
            errores.Add("La dedicación es obligatoria.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formulario.Modalidad))
        {
            errores.Add("La modalidad es obligatoria.");
            return;
        }

        if (!formulario.FechaIngreso.HasValue)
        {
            errores.Add("La fecha de ingreso es obligatoria.");
            return;
        }

        Resultado<bool> resultado;

        if (editando)
        {
            resultado = await Servicio.Reemplazar(
                docenteOriginal,
                departamentoOriginal,
                formulario);
        }
        else
        {
            resultado = await Servicio.Crear(formulario);
        }

        if (!resultado.Ok)
        {
            errores = resultado.Errores;
            return;
        }

        mensaje = editando
            ? "Relación actualizada correctamente."
            : "Relación creada correctamente.";

        formulario = Nuevo();
        editando = false;

        await Cargar();
    }

    private void Editar(DocenteDepartamento item)
    {
        editando = true;

        docenteOriginal = item.Docente;
        departamentoOriginal = item.Departamento;

        formulario = new DocenteDepartamento
        {
            Docente = item.Docente,
            Departamento = item.Departamento,
            Dedicacion = item.Dedicacion,
            Modalidad = item.Modalidad,
            FechaIngreso = item.FechaIngreso,
            FechaSalida = item.FechaSalida
        };

        mensaje = string.Empty;
        errores.Clear();
    }

    private async Task Eliminar(DocenteDepartamento item)
    {
        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Desea retirar esta relación?");

        if (!confirmar)
            return;

        mensaje = string.Empty;
        errores.Clear();

        var resultado = await Servicio.Eliminar(
            item.Docente,
            item.Departamento);

        if (!resultado.Ok)
        {
            errores = resultado.Errores;
            return;
        }

        mensaje = "Relación eliminada correctamente.";

        await Cargar();
    }

    private void CancelarEdicion()
    {
        editando = false;
        formulario = Nuevo();
        mensaje = string.Empty;
        errores.Clear();
    }

    private string NombreDocente(int cedula)
    {
        var docente =
            docentes.FirstOrDefault(x => x.Cedula == cedula);

        return docente == null
            ? cedula.ToString()
            : $"{cedula} - {docente.Nombres} {docente.Apellidos}";
    }

    private string NombrePrograma(int id)
    {
        var programa =
            programas.FirstOrDefault(x => x.Id == id);

        return programa == null
            ? id.ToString()
            : $"{id} - {programa.Nombre}";
    }

    private static string RutaFoto(int cedula) =>
        $"/images/docentes/{cedula}.jpg";

    private static string Iniciales(Docente docente)
    {
        var nombre = string.IsNullOrWhiteSpace(docente.Nombres)
            ? "D"
            : docente.Nombres.Trim()[0].ToString();

        var apellido = string.IsNullOrWhiteSpace(docente.Apellidos)
            ? string.Empty
            : docente.Apellidos.Trim()[0].ToString();

        return (nombre + apellido).ToUpperInvariant();
    }

    private static DocenteDepartamento Nuevo()
    {
        return new DocenteDepartamento
        {
            FechaIngreso = DateOnly.FromDateTime(DateTime.Today)
        };
    }
}
