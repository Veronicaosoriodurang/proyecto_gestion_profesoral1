@page "/docente-departamento"
@rendermode InteractiveServer
@using FrontGestion.Servicios
@inject ServicioDocenteDepartamento Servicio
@inject ServicioDocente ServicioDocente
@inject ServicioPrograma ServicioPrograma
@inject IJSRuntime JS

<PageTitle>Docente - Departamento</PageTitle>

<h1>Docente - Departamento</h1>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (errores.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in errores)
        {
            <div>@error</div>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4>
            @(editando
                ? "Editar relación"
                : "Nueva relación")
        </h4>

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Docente</label>

                <select class="form-select"
                        @bind="formulario.Docente"
                        disabled="@editando">

                    <option value="0">
                        Seleccione un docente
                    </option>

                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Cedula -
                            @docente.Nombres
                            @docente.Apellidos
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Departamento / Programa
                </label>

                <select class="form-select"
                        @bind="formulario.Departamento"
                        disabled="@editando">

                    <option value="0">
                        Seleccione un programa
                    </option>

                    @foreach (var programa in programas)
                    {
                        <option value="@programa.Id">
                            @programa.Id - @programa.Nombre
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Dedicación</label>

                <input class="form-control"
                       maxlength="15"
                       @bind="formulario.Dedicacion" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Modalidad</label>

                <input class="form-control"
                       maxlength="45"
                       @bind="formulario.Modalidad" />
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Fecha de ingreso
                </label>

                <input type="date"
                       class="form-control"
                       @bind="formulario.FechaIngreso" />
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Fecha de salida
                </label>

                <input type="date"
                       class="form-control"
                       @bind="formulario.FechaSalida" />
            </div>

        </div>

        <div class="mt-3">

            <button class="btn btn-primary me-2"
                    @onclick="Guardar">

                @(editando ? "Guardar cambios" : "Crear")
            </button>

            @if (editando)
            {
                <button class="btn btn-secondary"
                        @onclick="CancelarEdicion">
                    Cancelar
                </button>
            }

        </div>
    </div>
</div>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (relaciones.Count == 0)
{
    <div class="alert alert-info">
        No hay relaciones docente-departamento registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Docente</th>
                    <th>Departamento / Programa</th>
                    <th>Dedicación</th>
                    <th>Modalidad</th>
                    <th>Ingreso</th>
                    <th>Salida</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in relaciones)
                {
                    <tr>

                        <td>
                            @NombreDocente(item.Docente)
                        </td>

                        <td>
                            @NombrePrograma(item.Departamento)
                        </td>

                        <td>@item.Dedicacion</td>
                        <td>@item.Modalidad</td>

                        <td>
                            @item.FechaIngreso?.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @(item.FechaSalida.HasValue
                                ? item.FechaSalida.Value
                                    .ToString("yyyy-MM-dd")
                                : "-")
                        </td>

                        <td>

                            <button class="btn btn-sm btn-warning me-2"
                                    @onclick="() => Editar(item)">
                                Editar
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => Eliminar(item)">
                                Eliminar
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<DocenteDepartamento> relaciones = new();
    private List<Docente> docentes = new();
    private List<Programa> programas = new();

    private DocenteDepartamento formulario = Nuevo();

    private bool cargando = true;
    private bool editando = false;

    private int docenteOriginal;
    private int departamentoOriginal;

    private string mensaje = string.Empty;
    private List<string> errores = new();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        errores.Clear();

        var rRelaciones = await Servicio.Listar();
        var rDocentes = await ServicioDocente.Listar();
        var rProgramas = await ServicioPrograma.Listar();

        if (rRelaciones.Ok)
            relaciones = rRelaciones.Datos ?? new();
        else
            errores.AddRange(rRelaciones.Errores);

        if (rDocentes.Ok)
            docentes = rDocentes.Datos ?? new();
        else
            errores.AddRange(rDocentes.Errores);

        if (rProgramas.Ok)
            programas = rProgramas.Datos ?? new();
        else
            errores.AddRange(rProgramas.Errores);

        cargando = false;
    }

    private async Task Guardar()
    {
        mensaje = string.Empty;
        errores.Clear();

        if (formulario.Docente <= 0)
        {
            errores.Add("Debe seleccionar un docente.");
            return;
        }

        if (formulario.Departamento <= 0)
        {
            errores.Add(
                "Debe seleccionar un departamento/programa.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formulario.Dedicacion))
        {
            errores.Add("La dedicación es obligatoria.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formulario.Modalidad))
        {
            errores.Add("La modalidad es obligatoria.");
            return;
        }

        if (!formulario.FechaIngreso.HasValue)
        {
            errores.Add("La fecha de ingreso es obligatoria.");
            return;
        }

        Resultado<bool> resultado;

        if (editando)
        {
            resultado = await Servicio.Reemplazar(
                docenteOriginal,
                departamentoOriginal,
                formulario);
        }
        else
        {
            resultado = await Servicio.Crear(formulario);
        }

        if (!resultado.Ok)
        {
            errores = resultado.Errores;
            return;
        }

        mensaje = editando
            ? "Relación actualizada correctamente."
            : "Relación creada correctamente.";

        formulario = Nuevo();
        editando = false;

        await Cargar();
    }

    private void Editar(DocenteDepartamento item)
    {
        editando = true;

        docenteOriginal = item.Docente;
        departamentoOriginal = item.Departamento;

        formulario = new DocenteDepartamento
        {
            Docente = item.Docente,
            Departamento = item.Departamento,
            Dedicacion = item.Dedicacion,
            Modalidad = item.Modalidad,
            FechaIngreso = item.FechaIngreso,
            FechaSalida = item.FechaSalida
        };

        mensaje = string.Empty;
        errores.Clear();
    }

    private async Task Eliminar(DocenteDepartamento item)
    {
        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Desea retirar esta relación?");

        if (!confirmar)
            return;

        mensaje = string.Empty;
        errores.Clear();

        var resultado = await Servicio.Eliminar(
            item.Docente,
            item.Departamento);

        if (!resultado.Ok)
        {
            errores = resultado.Errores;
            return;
        }

        mensaje = "Relación eliminada correctamente.";

        await Cargar();
    }

    private void CancelarEdicion()
    {
        editando = false;
        formulario = Nuevo();
        mensaje = string.Empty;
        errores.Clear();
    }

    private string NombreDocente(int cedula)
    {
        var docente =
            docentes.FirstOrDefault(x => x.Cedula == cedula);

        return docente == null
            ? cedula.ToString()
            : $"{cedula} - {docente.Nombres} {docente.Apellidos}";
    }

    private string NombrePrograma(int id)
    {
        var programa =
            programas.FirstOrDefault(x => x.Id == id);

        return programa == null
            ? id.ToString()
            : $"{id} - {programa.Nombre}";
    }

    private static DocenteDepartamento Nuevo()
    {
        return new DocenteDepartamento
        {
            FechaIngreso = DateOnly.FromDateTime(DateTime.Today)
        };
    }
}
