@page "/docentes"
@rendermode InteractiveServer
@inject ServicioDocente Servicio
@inject ServicioLineaInvestigacion ServicioLineas
@inject IJSRuntime JS

<PageTitle>Docentes</PageTitle>

<div class="encabezado">
    <div>
        <h1>Docentes</h1>
        <p class="nota">
            Fichas del personal docente. Un docente retirado deja de aparecer aquí, pero no se borra de la base.
        </p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar el docente" : "Agregar el docente")</h2>

        <label>
            Cédula
            <input type="number" @bind="campoCedula" disabled="@editando" />
            @if (editando)
            {
                <span class="ayuda">
                    La cédula identifica la ficha y no se cambia. Si está mal, se agrega otra y se retira esta.
                </span>
            }
            else
            {
                <span class="ayuda">La cédula del docente. No se podrá cambiar después.</span>
            }
        </label>

        <label>
            Nombres
            <input type="text" maxlength="60" @bind="campoNombres" />
        </label>

        <label>
            Apellidos
            <input type="text" maxlength="60" @bind="campoApellidos" />
        </label>

        <label>
            Género
            <input type="text" maxlength="12" @bind="campoGenero" />
        </label>

        <label>
            Cargo
            <input type="text" maxlength="30" @bind="campoCargo" />
        </label>

        <label>
            Fecha de nacimiento
            <input type="date" @bind="campoFechaNacimiento" />
        </label>

        <label>
            Correo
            <input type="text" maxlength="70" @bind="campoCorreo" />
        </label>

        <label>
            Teléfono
            <input type="text" maxlength="20" @bind="campoTelefono" />
        </label>

        <label>
            URL CvLAC
            <input type="text" maxlength="128" @bind="campoUrlCvlac" />
        </label>

        <label>
            Fecha de actualización
            <input type="date" @bind="campoFechaActualizacion" />
        </label>

        <label>
            Escalafón
            <input type="text" maxlength="45" @bind="campoEscalafon" />
        </label>

        <label>
            Perfil
            <textarea @bind="campoPerfil"></textarea>
        </label>

        <label>
            Categoría Minciencias
            <input type="text" maxlength="45" @bind="campoCatMinciencia" />
            <span class="ayuda">Opcional.</span>
        </label>

        <label>
            Convocatoria Minciencias
            <input type="text" maxlength="45" @bind="campoConvMinciencia" />
        </label>

        <label>
            Nacionalidad
            <input type="text" maxlength="45" @bind="campoNacionalidaad" />
        </label>

        <label>
            Línea de investigación principal
            <select @bind="campoLineaTexto">
                <option value="">Sin línea principal</option>
                @foreach (var linea in lineas)
                {
                    <option value="@linea.Id">@linea.Nombre</option>
                }
            </select>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige los datos obligatorios. «Solo lo que cambié» guarda lo diligenciado y deja lo demás como estaba.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Cargo</th>
                    <th>Correo</th>
                    <th>Línea principal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td><code>@fila.Cedula</code></td>
                        <td>@fila.Nombres</td>
                        <td>@fila.Apellidos</td>
                        <td>@fila.Cargo</td>
                        <td>@fila.Correo</td>
                        <td>@NombreLinea(fila.LineaInvestigacionPrincipal)</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count ficha(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay docentes. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Docente> filas = new();
    private List<LineaInvestigacion> lineas = new();
    private Dictionary<int, string> nombresLinea = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;

    private int campoCedula;
    private string campoNombres = string.Empty;
    private string campoApellidos = string.Empty;
    private string campoGenero = string.Empty;
    private string campoCargo = string.Empty;
    private DateOnly? campoFechaNacimiento;
    private string campoCorreo = string.Empty;
    private string campoTelefono = string.Empty;
    private string campoUrlCvlac = string.Empty;
    private DateOnly? campoFechaActualizacion;
    private string campoEscalafon = string.Empty;
    private string campoPerfil = string.Empty;
    private string campoCatMinciencia = string.Empty;
    private string campoConvMinciencia = string.Empty;
    private string campoNacionalidaad = string.Empty;
    private string campoLineaTexto = string.Empty;

    protected override async Task OnInitializedAsync() => await Cargar();

    private string NombreLinea(int? id)
    {
        if (id is int i && nombresLinea.TryGetValue(i, out var nombre))
            return nombre;
        return "—";
    }

    private int? LineaSeleccionada()
    {
        if (string.IsNullOrWhiteSpace(campoLineaTexto)) return null;
        return int.TryParse(campoLineaTexto, out var id) ? id : null;
    }

    private async Task Cargar()
    {
        cargando = true;

        var rLineas = await ServicioLineas.Listar();
        if (rLineas.Ok)
        {
            lineas = rLineas.Datos!;
            nombresLinea = lineas.ToDictionary(l => l.Id, l => l.Nombre);
        }
        else
        {
            lineas = new();
            nombresLinea = new();
        }

        var r = await Servicio.Listar();
        cargando = false;

        errores = r.Errores;
        if (!rLineas.Ok)
        {
            errores = errores.Concat(rLineas.Errores).ToList();
        }
        filas = r.Ok ? r.Datos! : new();
    }

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Docente fila)
    {
        campoCedula = fila.Cedula;
        campoNombres = fila.Nombres;
        campoApellidos = fila.Apellidos;
        campoGenero = fila.Genero;
        campoCargo = fila.Cargo;
        campoFechaNacimiento = fila.FechaNacimiento;
        campoCorreo = fila.Correo;
        campoTelefono = fila.Telefono;
        campoUrlCvlac = fila.UrlCvlac;
        campoFechaActualizacion = fila.FechaActualizacion;
        campoEscalafon = fila.Escalafon;
        campoPerfil = fila.Perfil;
        campoCatMinciencia = fila.CatMinciencia ?? string.Empty;
        campoConvMinciencia = fila.ConvMinciencia;
        campoNacionalidaad = fila.Nacionalidaad;
        campoLineaTexto = fila.LineaInvestigacionPrincipal?.ToString() ?? string.Empty;
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoCedula = 0;
        campoNombres = string.Empty;
        campoApellidos = string.Empty;
        campoGenero = string.Empty;
        campoCargo = string.Empty;
        campoFechaNacimiento = null;
        campoCorreo = string.Empty;
        campoTelefono = string.Empty;
        campoUrlCvlac = string.Empty;
        campoFechaActualizacion = null;
        campoEscalafon = string.Empty;
        campoPerfil = string.Empty;
        campoCatMinciencia = string.Empty;
        campoConvMinciencia = string.Empty;
        campoNacionalidaad = string.Empty;
        campoLineaTexto = string.Empty;
        errores = new();
        exito = string.Empty;
    }

    private Docente ArmarFicha() => new()
    {
        Cedula = campoCedula,
        Nombres = campoNombres.Trim(),
        Apellidos = campoApellidos.Trim(),
        Genero = campoGenero.Trim(),
        Cargo = campoCargo.Trim(),
        FechaNacimiento = campoFechaNacimiento,
        Correo = campoCorreo.Trim(),
        Telefono = campoTelefono.Trim(),
        UrlCvlac = campoUrlCvlac.Trim(),
        FechaActualizacion = campoFechaActualizacion,
        Escalafon = campoEscalafon.Trim(),
        Perfil = campoPerfil.Trim(),
        CatMinciencia = string.IsNullOrWhiteSpace(campoCatMinciencia)
            ? null
            : campoCatMinciencia.Trim(),
        ConvMinciencia = campoConvMinciencia.Trim(),
        Nacionalidaad = campoNacionalidaad.Trim(),
        LineaInvestigacionPrincipal = LineaSeleccionada()
    };

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(ArmarFicha());
        guardando = false;
        await TrasGuardar(r, $"Se agregó el docente {campoCedula}.");
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoCedula, ArmarFicha());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el docente {campoCedula}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(
            campoCedula,
            campoNombres,
            campoApellidos,
            campoGenero,
            campoCargo,
            campoFechaNacimiento,
            campoCorreo,
            campoTelefono,
            campoUrlCvlac,
            campoFechaActualizacion,
            campoEscalafon,
            campoPerfil,
            campoCatMinciencia,
            campoConvMinciencia,
            campoNacionalidaad,
            LineaSeleccionada());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el docente {campoCedula}.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Docente fila)
    {
        var seguro = await JS.InvokeAsync<bool>(
            "confirm", $"¿Retirar {fila.Cedula} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Cedula);
        if (r.Ok)
        {
            exito = $"Se retiró el docente {fila.Cedula}.";
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
