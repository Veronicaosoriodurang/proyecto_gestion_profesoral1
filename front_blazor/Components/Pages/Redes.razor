@page "/redes"
@rendermode InteractiveServer
@inject ServicioRed Servicio
@inject IJSRuntime JS

<PageTitle>Redes</PageTitle>

<div class="encabezado">
    <div>
        <h1>Redes académicas</h1>
        <p class="nota">
            Gestión de las redes académicas vinculadas al módulo de Gestión Profesoral.
        </p>
    </div>

    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}

@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">

        <h2>@(editando ? "Editar la red" : "Agregar la red")</h2>

        <label>
            Código
            <input type="number" @bind="campoIdr" disabled="@editando" />
        </label>

        <label>
            Nombre
            <input type="text" maxlength="45" @bind="campoNombre" />
        </label>

        <label>
            URL
            <input type="text" maxlength="45" @bind="campoUrl" />
        </label>

        <label>
            País
            <input type="text" maxlength="45" @bind="campoPais" />
        </label>

        <div class="pareja">

            @if (editando)
            {
                <button class="boton primario"
                        @onclick="GuardarCompleta"
                        disabled="@guardando">
                    Guardar la ficha completa
                </button>

                <button class="boton"
                        @onclick="GuardarLoQueCambio"
                        disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario"
                        @onclick="Crear"
                        disabled="@guardando">
                    Agregar
                </button>
            }

            <button class="boton"
                    @onclick="Cancelar"
                    disabled="@guardando">
                Cancelar
            </button>
        </div>
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>URL</th>
                    <th>País</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td><code>@fila.Idr</code></td>
                        <td>@fila.Nombre</td>
                        <td>@fila.Url</td>
                        <td>@fila.Pais</td>
                        <td>
                            <div class="acciones">
                                <button class="boton"
                                        @onclick="() => Editar(fila)">
                                    Editar
                                </button>

                                <button class="boton peligro"
                                        @onclick="() => Retirar(fila)">
                                    Retirar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="nota">@filas.Count ficha(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay redes. Use «Agregar» para crear la primera.
    </p>
}

@code {

    private List<Red> filas = new();
    private List<string> errores = new();

    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;

    private int campoIdr;
    private string campoNombre = string.Empty;
    private string campoUrl = string.Empty;
    private string campoPais = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;

        var r = await Servicio.Listar();

        cargando = false;

        errores = r.Errores;
        filas = r.Ok ? r.Datos! : new();
    }

    private void Agregar()
    {
        Limpiar();

        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Red fila)
    {
        campoIdr = fila.Idr;
        campoNombre = fila.Nombre;
        campoUrl = fila.Url;
        campoPais = fila.Pais;

        editando = true;
        mostrandoFormulario = true;

        errores = new();
        exito = string.Empty;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoIdr = 0;
        campoNombre = string.Empty;
        campoUrl = string.Empty;
        campoPais = string.Empty;

        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;

        var r = await Servicio.Crear(new Red
        {
            Idr = campoIdr,
            Nombre = campoNombre.Trim(),
            Url = campoUrl.Trim(),
            Pais = campoPais.Trim()
        });

        guardando = false;

        await TrasGuardar(
            r,
            $"Se agregó la red {campoIdr}.");
    }

    private async Task GuardarCompleta()
    {
        guardando = true;

        var r = await Servicio.Reemplazar(
            campoIdr,
            new Red
            {
                Nombre = campoNombre.Trim(),
                Url = campoUrl.Trim(),
                Pais = campoPais.Trim()
            });

        guardando = false;

        await TrasGuardar(
            r,
            $"Se guardó la red {campoIdr}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;

        var r = await Servicio.Actualizar(
            campoIdr,
            campoNombre,
            campoUrl,
            campoPais);

        guardando = false;

        await TrasGuardar(
            r,
            $"Se guardó la red {campoIdr}.");
    }

    private async Task TrasGuardar(
        Resultado<bool> r,
        string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;

            exito = mensaje;
            errores = new();

            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Red fila)
    {
        var seguro = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Retirar la red {fila.Idr} del uso?");

        if (!seguro)
            return;

        var r = await Servicio.Eliminar(fila.Idr);

        if (r.Ok)
        {
            exito = $"Se retiró la red {fila.Idr}.";
            errores = new();

            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
