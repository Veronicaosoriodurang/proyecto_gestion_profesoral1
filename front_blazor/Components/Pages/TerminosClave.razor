@page "/terminos-clave"
@rendermode InteractiveServer
@inject ServicioTerminoClave Servicio
@inject IJSRuntime JS

<PageTitle>Términos clave</PageTitle>

<div class="encabezado">
    <div>
        <h1>Términos clave</h1>
        <p class="nota">
            Gestión de términos clave y su equivalente en inglés.
        </p>
    </div>

    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}

@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">

        <h2>@(editando ? "Editar término clave" : "Agregar término clave")</h2>

        <label>
            Término
            <input type="text" maxlength="30" @bind="campoTermino" disabled="@editando" />
        </label>

        <label>
            Término en inglés
            <input type="text" maxlength="30" @bind="campoTerminoIngles" />
            <span class="ayuda">Este campo es opcional.</span>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario"
                        @onclick="GuardarCompleta"
                        disabled="@guardando">
                    Guardar la ficha completa
                </button>

                <button class="boton"
                        @onclick="GuardarLoQueCambio"
                        disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario"
                        @onclick="Crear"
                        disabled="@guardando">
                    Agregar
                </button>
            }

            <button class="boton"
                    @onclick="Cancelar"
                    disabled="@guardando">
                Cancelar
            </button>
        </div>
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Término</th>
                    <th>Término en inglés</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@fila.Termino</td>
                        <td>@fila.TerminoIngles</td>
                        <td>
                            <div class="acciones">
                                <button class="boton"
                                        @onclick="() => Editar(fila)">
                                    Editar
                                </button>

                                <button class="boton peligro"
                                        @onclick="() => Retirar(fila)">
                                    Retirar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="nota">@filas.Count ficha(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay términos clave. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<TerminoClave> filas = new();
    private List<string> errores = new();

    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;

    private string campoTermino = string.Empty;
    private string campoTerminoIngles = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;

        var r = await Servicio.Listar();

        cargando = false;

        errores = r.Errores;
        filas = r.Ok ? r.Datos! : new();
    }

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(TerminoClave fila)
    {
        campoTermino = fila.Termino;
        campoTerminoIngles = fila.TerminoIngles ?? string.Empty;

        editando = true;
        mostrandoFormulario = true;

        errores = new();
        exito = string.Empty;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoTermino = string.Empty;
        campoTerminoIngles = string.Empty;

        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;

        var r = await Servicio.Crear(new TerminoClave
        {
            Termino = campoTermino.Trim(),
            TerminoIngles = string.IsNullOrWhiteSpace(campoTerminoIngles)
                ? null
                : campoTerminoIngles.Trim()
        });

        guardando = false;

        await TrasGuardar(
            r,
            $"Se agregó el término '{campoTermino}'.");
    }

    private async Task GuardarCompleta()
    {
        guardando = true;

        var r = await Servicio.Reemplazar(
            campoTermino,
            new TerminoClave
            {
                TerminoIngles = string.IsNullOrWhiteSpace(campoTerminoIngles)
                    ? null
                    : campoTerminoIngles.Trim()
            });

        guardando = false;

        await TrasGuardar(
            r,
            $"Se guardó el término '{campoTermino}'.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;

        var r = await Servicio.Actualizar(
            campoTermino,
            string.IsNullOrWhiteSpace(campoTerminoIngles)
                ? null
                : campoTerminoIngles.Trim());

        guardando = false;

        await TrasGuardar(
            r,
            $"Se guardó el término '{campoTermino}'.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();

            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(TerminoClave fila)
    {
        var seguro = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Retirar el término '{fila.Termino}' del uso?");

        if (!seguro)
            return;

        var r = await Servicio.Eliminar(fila.Termino);

        if (r.Ok)
        {
            exito = $"Se retiró el término '{fila.Termino}'.";
            errores = new();

            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
