@page "/becas"
@rendermode InteractiveServer
@inject ServicioBeca Servicio
@inject ServicioEstudioRealizado ServicioEstudios
@inject IJSRuntime JS

<PageTitle>Becas</PageTitle>

<div class="encabezado">
    <div>
        <h1>Becas</h1>
        <p class="nota">
            Registro de becas asociadas a estudios realizados.
        </p>
    </div>

    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">
            Agregar
        </button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}

@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">

        <h2>
            @(editando ? "Editar beca" : "Agregar beca")
        </h2>

        <label>
            Estudio realizado
            <select @bind="campoEstudio">
                <option value="">Seleccione un estudio</option>

                @foreach (var estudio in estudios)
                {
                    <option value="@estudio.Id">
                        @estudio.Id - @estudio.Titulo
                    </option>
                }
            </select>
        </label>

        <label>
            Tipo
            <input type="text"
                   maxlength="45"
                   @bind="campoTipo" />
        </label>

        <label>
            Institución
            <input type="text"
                   maxlength="80"
                   @bind="campoInstitucion" />
        </label>

        <label>
            Fecha de inicio
            <input type="date"
                   @bind="campoFechaInicio" />
        </label>

        <label>
            Fecha de fin
            <input type="date"
                   @bind="campoFechaFin" />
        </label>

        <div class="pareja">

            <button class="boton primario"
                    @onclick="Guardar"
                    disabled="@guardando">
                @(editando ? "Guardar" : "Agregar")
            </button>

            <button class="boton"
                    @onclick="Cancelar"
                    disabled="@guardando">
                Cancelar
            </button>

        </div>
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">

        <table>
            <thead>
                <tr>
                    <th>Estudio</th>
                    <th>Tipo</th>
                    <th>Institución</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@NombreEstudio(fila.Estudios)</td>
                        <td>@fila.Tipo</td>
                        <td>@fila.Institucion</td>
                        <td>@fila.FechaInicio</td>

                        <td>
                            @(fila.FechaFin.HasValue
                                ? fila.FechaFin.ToString()
                                : "Sin registrar")
                        </td>

                        <td>
                            <div class="acciones">

                                <button class="boton"
                                        @onclick="() => Editar(fila)">
                                    Editar
                                </button>

                                <button class="boton peligro"
                                        @onclick="() => Retirar(fila)">
                                    Retirar
                                </button>

                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

    <p class="nota">
        @filas.Count registro(s).
    </p>
}
else
{
    <p class="vacio">
        Todavía no hay becas registradas.
    </p>
}

@code {

    private List<Beca> filas = new();
    private List<EstudioRealizado> estudios = new();

    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;

    private int estudioOriginal;

    private string campoEstudio = string.Empty;
    private string campoTipo = string.Empty;
    private string campoInstitucion = string.Empty;
    private DateOnly? campoFechaInicio;
    private DateOnly? campoFechaFin;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        errores.Clear();

        var rEstudios = await ServicioEstudios.Listar();

        if (rEstudios.Ok)
            estudios = rEstudios.Datos ?? new();
        else
            errores.AddRange(rEstudios.Errores);

        var r = await Servicio.Listar();

        if (r.Ok)
            filas = r.Datos ?? new();
        else
            errores.AddRange(r.Errores);

        cargando = false;
    }

    private string NombreEstudio(int id)
    {
        var estudio = estudios.FirstOrDefault(x => x.Id == id);

        return estudio == null
            ? id.ToString()
            : $"{id} - {estudio.Titulo}";
    }

    private void Agregar()
    {
        estudioOriginal = 0;

        campoEstudio = string.Empty;
        campoTipo = string.Empty;
        campoInstitucion = string.Empty;
        campoFechaInicio =
            DateOnly.FromDateTime(DateTime.Today);
        campoFechaFin = null;

        editando = false;
        mostrandoFormulario = true;

        errores.Clear();
        exito = string.Empty;
    }

    private void Editar(Beca fila)
    {
        estudioOriginal = fila.Estudios;

        campoEstudio = fila.Estudios.ToString();
        campoTipo = fila.Tipo;
        campoInstitucion = fila.Institucion;
        campoFechaInicio = fila.FechaInicio;
        campoFechaFin = fila.FechaFin;

        editando = true;
        mostrandoFormulario = true;

        errores.Clear();
        exito = string.Empty;
    }

    private bool Validar()
    {
        errores.Clear();

        if (!int.TryParse(campoEstudio, out _))
            errores.Add("Debe seleccionar un estudio.");

        if (string.IsNullOrWhiteSpace(campoTipo))
            errores.Add("Debe ingresar el tipo de beca.");

        if (string.IsNullOrWhiteSpace(campoInstitucion))
            errores.Add("Debe ingresar la institución.");

        if (!campoFechaInicio.HasValue)
            errores.Add("Debe seleccionar la fecha de inicio.");

        if (campoFechaInicio.HasValue &&
            campoFechaFin.HasValue &&
            campoFechaFin.Value < campoFechaInicio.Value)
        {
            errores.Add(
                "La fecha de fin no puede ser anterior a la fecha de inicio.");
        }

        return errores.Count == 0;
    }

    private Beca Construir()
    {
        return new Beca
        {
            Estudios = int.Parse(campoEstudio),
            Tipo = campoTipo.Trim(),
            Institucion = campoInstitucion.Trim(),
            FechaInicio = campoFechaInicio,
            FechaFin = campoFechaFin
        };
    }

    private async Task Guardar()
    {
        exito = string.Empty;

        if (!Validar())
            return;

        guardando = true;

        var entidad = Construir();

        Resultado<bool> resultado;

        if (editando)
        {
            resultado = await Servicio.Reemplazar(
                estudioOriginal,
                entidad);
        }
        else
        {
            resultado = await Servicio.Crear(entidad);
        }

        guardando = false;

        if (!resultado.Ok)
        {
            errores.AddRange(resultado.Errores);
            return;
        }

        exito = editando
            ? "Beca actualizada."
            : "Beca agregada.";

        mostrandoFormulario = false;

        await Cargar();
    }

    private async Task Retirar(Beca fila)
    {
        var confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                "¿Retirar esta beca?");

        if (!confirmar)
            return;

        errores.Clear();
        exito = string.Empty;

        var resultado =
            await Servicio.Eliminar(fila.Estudios);

        if (!resultado.Ok)
        {
            errores.AddRange(resultado.Errores);
            return;
        }

        exito = "Beca retirada.";

        await Cargar();
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        errores.Clear();
    }
}
