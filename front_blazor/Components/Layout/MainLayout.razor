@inherits LayoutComponentBase

<div class="pagina">
    <header class="cabecera-app">
        <div class="barra-institucional">
            <div class="contenedor barra-institucional-interna">
                <a class="marca-app" href="" aria-label="Ir al inicio de Gestión Profesoral">
                    <span class="marca-simbolo">GP</span>
                    <span class="marca-texto">
                        <strong>Gestión Profesoral</strong>
                        <small>Proyecto académico ITM</small>
                    </span>
                </a>
                <div class="estado-version" title="Versión actual del proyecto">
                    <span class="estado-punto"></span>
                    <span>Versión 2</span>
                </div>
            </div>
        </div>
        <NavMenu />
    </header>

    <main class="contenedor contenido-principal">
        @Body
    </main>

    <footer class="pie-app">
        <div class="contenedor pie-app-interno">
            <div>
                <strong>Gestión Profesoral</strong>
                <p>Información docente organizada de forma clara y segura.</p>
            </div>
            <div class="pie-academico">
                <span>Aplicación y Servicios Web</span>
                <span>Instituto Tecnológico Metropolitano — ITM</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">×</span>
</div>
