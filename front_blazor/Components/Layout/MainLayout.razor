@inherits LayoutComponentBase

<div class="pagina">
    <header class="premium-header">
        <div class="contenedor premium-header-inner">
            <a class="brand" href="">
                <span class="brand-mark">GP</span>
                <span class="brand-copy">
                    <strong>Gestión Profesoral</strong>
                    <small>Instituto Tecnológico Metropolitano</small>
                </span>
            </a>
            <div class="header-meta">
                <span>Aplicación y Servicios Web</span>
                <span class="version-pill">v2</span>
            </div>
        </div>
        <NavMenu />
    </header>

    <main class="contenedor app-main">
        @Body
    </main>

    <footer class="contenedor premium-footer">
        <p>Gestión Profesoral · Proyecto académico ITM · Veronica Osorio Durango</p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">×</span>
</div>
